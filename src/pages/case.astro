---
import BaseLayout from '../layouts/BaseLayout.astro';
import VisualPlaceholderGrid from '../components/support/VisualPlaceholderGrid.astro';

const techSummary = [
  'Astro',
  'Tailwind',
  'TypeScript',
  'Static data model',
  'Component-based architecture',
];

const whatThisShows = [
  'SaaS UX without generic dashboard styling',
  'Audit logic modeling with structured local data',
  'Frontend architecture that stays readable as the demo grows',
  'A documentation system that tracks the project as it changes',
];

const visualPlaceholders = [
  {
    label: 'Visual slot 01',
    title: 'Homepage hero',
    caption: 'Reserved for the entry screen and report access point.',
  },
  {
    label: 'Visual slot 02',
    title: 'Report detail',
    caption: 'Reserved for the score, findings, and priority sequence.',
  },
  {
    label: 'Visual slot 03',
    title: 'Closing handoff',
    caption: 'Reserved for the final action layer and trust note.',
  },
];
---

<BaseLayout
  title="AuditLab | Project Context"
  description="A concise portfolio context page for the AuditLab demo."
>
  <main
    id="main-content"
    tabindex="-1"
    class="mx-auto flex min-h-screen w-full max-w-4xl flex-col px-6 py-6 sm:px-8 lg:px-10"
  >
    <header
      class="flex items-center justify-between border-b border-white/10 pb-4"
    >
      <div>
        <p class="text-xs uppercase tracking-[0.3em] text-slate-400">
          Portfolio context
        </p>
        <h1 class="mt-2 text-2xl font-semibold tracking-tight text-slate-50">
          AuditLab project context
        </h1>
      </div>

      <a
        href="/"
        class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-medium uppercase tracking-[0.22em] text-slate-300 transition hover:bg-white/10 hover:text-white"
      >
        Back
      </a>
    </header>

    <section
      class="grid gap-6 py-10 lg:grid-cols-[minmax(0,1fr)_18rem] lg:items-start"
    >
      <div class="space-y-6">
        <div
          class="rounded-[2rem] border border-white/10 bg-white/5 p-6 sm:p-7"
        >
          <p class="text-xs uppercase tracking-[0.3em] text-slate-400">
            What this project demonstrates
          </p>
          <p class="mt-3 max-w-2xl text-base leading-7 text-slate-300">
            AuditLab is a fictional SaaS audit product built to show a calm,
            structured front end that can present findings, explain priorities,
            and stay credible without backend dependencies.
          </p>
        </div>

        <div
          class="rounded-[2rem] border border-white/10 bg-white/5 p-6 sm:p-7"
        >
          <p class="text-xs uppercase tracking-[0.3em] text-slate-400">
            What this shows
          </p>
          <ul class="mt-4 grid gap-3">
            {
              whatThisShows.map((item) => (
                <li class="rounded-2xl border border-white/10 bg-slate-950/60 p-4 text-sm leading-6 text-slate-300">
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <aside
        class="space-y-4 rounded-[2rem] border border-white/10 bg-slate-950/75 p-6 shadow-2xl shadow-slate-950/30"
      >
        <div>
          <p class="text-xs uppercase tracking-[0.3em] text-slate-400">
            Tech + scope
          </p>
          <ul class="mt-4 space-y-2">
            {
              techSummary.map((item) => (
                <li class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-slate-200">
                  {item}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
          <p class="text-xs uppercase tracking-[0.24em] text-slate-400">
            Design goals
          </p>
          <p class="mt-2 text-sm leading-6 text-slate-300">
            Mobile first, wide-screen aware, and minimal enough to keep the
            report as the main experience.
          </p>
        </div>
      </aside>
    </section>

    <section class="border-t border-white/10 py-8">
      <div class="max-w-3xl space-y-3">
        <p class="text-xs uppercase tracking-[0.3em] text-slate-400">
          Visual placeholders
        </p>
        <h2 class="text-2xl font-semibold tracking-tight text-slate-50">
          Space reserved for product visuals
        </h2>
        <p class="text-sm leading-6 text-slate-300">
          These semantic frames are ready for screenshots or product renders
          later. They keep the layout practical without pretending to be fake
          captures.
        </p>
      </div>

      <div class="mt-6">
        <VisualPlaceholderGrid items={visualPlaceholders} />
      </div>
    </section>

    <section class="border-t border-white/10 py-8">
      <div
        class="rounded-[2rem] border border-white/10 bg-white/5 p-6 sm:p-7 lg:p-8"
      >
        <div
          class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-start"
        >
          <div class="space-y-3">
            <p class="text-xs uppercase tracking-[0.3em] text-slate-400">
              Portfolio contact
            </p>
            <h2 class="text-2xl font-semibold tracking-tight text-slate-50">
              Contact belongs to the portfolio owner.
            </h2>
            <p class="max-w-2xl text-sm leading-6 text-slate-300 sm:text-base">
              The support pages and project context are part of the portfolio
              framing. Questions about the work should go through the owner, not
              through any fake product support flow.
            </p>
          </div>

          <div class="flex flex-col gap-3 text-sm">
            <a
              href="/portfolio-disclosure"
              class="inline-flex items-center justify-center rounded-full bg-slate-100 px-5 py-3 font-semibold text-slate-950 transition hover:bg-white"
            >
              Read disclosure
            </a>
            <a
              href="https://copycodeai.online"
              class="inline-flex items-center justify-center rounded-full border border-white/10 bg-white/5 px-5 py-3 font-semibold text-slate-100 transition hover:bg-white/10"
            >
              copycodeai.online
            </a>
            <a
              href="mailto:hello@copycodeai.online"
              class="inline-flex items-center justify-center rounded-full border border-white/10 bg-white/5 px-5 py-3 font-semibold text-slate-100 transition hover:bg-white/10"
            >
              hello@copycodeai.online
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
