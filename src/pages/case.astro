---
import BaseLayout from '../layouts/BaseLayout.astro';
import VisualPlaceholderGrid from '../components/support/VisualPlaceholderGrid.astro';

const techSummary = [
  'Astro',
  'Tailwind',
  'TypeScript',
  'Static data model',
  'Component-based architecture',
];

const whatThisShows = [
  'SaaS UX without generic dashboard styling',
  'Audit logic modeling with structured local data',
  'Frontend architecture that stays readable as the demo grows',
  'A documentation system that tracks the project as it changes',
];

const visualPlaceholders = [
  {
    label: 'Visual slot 01',
    title: 'Homepage hero',
    caption: 'Reserved for the entry screen and report access point.',
  },
  {
    label: 'Visual slot 02',
    title: 'Report detail',
    caption: 'Reserved for the score, findings, and priority sequence.',
  },
  {
    label: 'Visual slot 03',
    title: 'Closing handoff',
    caption: 'Reserved for the final action layer and trust note.',
  },
];
---

<BaseLayout
  title="AuditLab | Project Context"
  description="A concise portfolio context page for the AuditLab demo."
  showShellHeader={false}
>
  <main
    id="main-content"
    tabindex="-1"
    class="mx-auto flex min-h-screen w-full max-w-7xl flex-col px-4 py-4 sm:px-8 sm:py-6 lg:px-10"
  >
    <header
      class="audit-frame audit-frame--quiet flex items-center justify-between px-4 py-3"
    >
      <div>
        <p class="audit-eyebrow">Portfolio context</p>
        <h1
          class="mt-2 text-2xl font-semibold tracking-tight text-[color:var(--audit-text-0)]"
        >
          AuditLab project context
        </h1>
      </div>

      <a href="/" class="audit-chip audit-chip--muted"> Back </a>
    </header>

    <section
      class="audit-section grid gap-6 py-10 lg:grid-cols-[minmax(0,1fr)_18rem] lg:items-start"
    >
      <div class="space-y-6">
        <div class="audit-panel audit-panel--raised p-6 sm:p-7">
          <p class="audit-eyebrow">What this project demonstrates</p>
          <p
            class="mt-3 max-w-2xl text-lg leading-8 text-[color:var(--audit-text-1)]"
          >
            AuditLab is a fictional SaaS audit product built to show a calm,
            structured front end that can present findings, explain priorities,
            and stay credible without backend dependencies.
          </p>
        </div>

        <div class="audit-panel audit-panel--raised p-6 sm:p-7">
          <p class="audit-eyebrow">What this shows</p>
          <ul class="mt-4 grid gap-3">
            {
              whatThisShows.map((item) => (
                <li class="audit-card audit-card--quiet p-4 text-sm leading-6 text-[color:var(--audit-text-1)]">
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <aside class="audit-panel audit-panel--raised space-y-4 p-6">
        <div>
          <p class="audit-eyebrow">Tech + scope</p>
          <ul class="mt-4 space-y-2">
            {
              techSummary.map((item) => (
                <li class="audit-card audit-card--quiet px-4 py-3 text-sm leading-6 text-[color:var(--audit-text-1)]">
                  {item}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="audit-panel audit-panel--inset p-4">
          <p class="audit-label">Design goals</p>
          <p class="mt-2 text-sm leading-6 text-[color:var(--audit-text-1)]">
            Mobile first, wide-screen aware, and minimal enough to keep the
            report as the main experience.
          </p>
        </div>
      </aside>
    </section>

    <section class="audit-section py-10">
      <div class="max-w-3xl space-y-3">
        <p class="audit-eyebrow">Visual placeholders</p>
        <h2
          class="text-2xl font-semibold tracking-tight text-[color:var(--audit-text-0)]"
        >
          Space reserved for product visuals
        </h2>
        <p class="text-sm leading-6 text-[color:var(--audit-text-1)]">
          These semantic frames are ready for screenshots or product renders
          later. They keep the layout practical without pretending to be fake
          captures.
        </p>
      </div>

      <div class="mt-6">
        <VisualPlaceholderGrid items={visualPlaceholders} />
      </div>
    </section>

    <section class="audit-section py-10">
      <div class="audit-panel audit-panel--raised p-6 sm:p-7 lg:p-8">
        <div
          class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_18rem] lg:items-start"
        >
          <div class="space-y-3">
            <p class="audit-eyebrow">Portfolio contact</p>
            <h2
              class="text-2xl font-semibold tracking-tight text-[color:var(--audit-text-0)]"
            >
              Contact belongs to the portfolio owner.
            </h2>
            <p
              class="max-w-2xl text-sm leading-6 text-[color:var(--audit-text-1)] sm:text-base"
            >
              The support pages and project context are part of the portfolio
              framing. Questions about the work should go through the owner, not
              through any fake product support flow.
            </p>
          </div>

          <div class="flex flex-col gap-3 text-sm">
            <a
              href="/portfolio-disclosure"
              class="audit-btn audit-btn--primary"
            >
              Read disclosure
            </a>
            <a
              href="https://copycodeai.online"
              class="audit-btn audit-btn--secondary"
            >
              copycodeai.online
            </a>
            <a
              href="mailto:hello@copycodeai.online"
              class="audit-btn audit-btn--secondary"
            >
              hello@copycodeai.online
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
