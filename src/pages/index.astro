---
import BaseLayout from '../layouts/BaseLayout.astro';

const auditFocusAreas = [
  {
    label: 'Privacy / GDPR',
    copy: 'Checks disclosure placement, third-party behavior, and whether the privacy story is easy to defend.',
  },
  {
    label: 'Cookies',
    copy: 'Looks at consent balance, banner clarity, and whether the choice feels genuinely neutral.',
  },
  {
    label: 'Accessibility',
    copy: 'Reviews structure, contrast, keyboard support, and the parts that affect everyday use.',
  },
  {
    label: 'UX',
    copy: 'Checks the first read, the hierarchy, and whether the page explains itself quickly enough.',
  },
];

const auditSteps = [
  {
    step: '01',
    title: 'Enter a site',
    copy: 'The demo starts from a URL and treats the site as an audit subject, not a marketing target.',
  },
  {
    step: '02',
    title: 'Review findings',
    copy: 'The report surfaces the issues, why they matter, and which ones change the overall picture.',
  },
  {
    step: '03',
    title: 'Prioritize fixes',
    copy: 'The end of the report turns the audit into a short, practical sequence of next actions.',
  },
];

const previewFindings: {
  severity: PreviewSeverity;
  title: string;
  copy: string;
}[] = [
  {
    severity: 'high',
    title: 'Consent controls favor acceptance',
    copy: 'The cookie decision is not visually neutral, which weakens trust before the user reads the explanation.',
  },
  {
    severity: 'high',
    title: 'Scripts begin before consent is clear',
    copy: 'Some third-party behavior appears too early, which makes the privacy story harder to defend.',
  },
  {
    severity: 'medium',
    title: 'Focus states need clearer contrast',
    copy: 'The interface is readable, but keyboard users still benefit from stronger visibility on dark surfaces.',
  },
];

type PreviewSeverity = 'high' | 'medium';

const severityStyles: Record<PreviewSeverity, string> = {
  high: 'audit-chip--status-danger',
  medium: 'audit-chip--status-warning',
};
---

<BaseLayout
  title="AuditLab"
  description="AuditLab is a calm, report-first demo that audits privacy, cookies, accessibility, and UX."
>
  <main
    id="main-content"
    tabindex="-1"
    class="mx-auto flex min-h-screen w-full max-w-7xl flex-col px-4 py-4 sm:px-8 sm:py-6 lg:px-10"
  >
    <section
      class="audit-hero grid gap-8 px-5 py-8 sm:px-6 sm:py-9 lg:grid-cols-[minmax(0,1.08fr)_minmax(0,0.92fr)] lg:items-center lg:px-10 lg:py-14"
    >
      <div class="space-y-7 lg:py-4">
        <div class="space-y-4 sm:space-y-5">
          <p class="audit-eyebrow">AuditLab overview</p>
          <h1
            class="max-w-2xl text-[2.45rem] font-semibold tracking-[-0.06em] text-balance leading-[0.95] text-[color:var(--audit-text-0)] sm:text-5xl lg:text-[5.4rem]"
          >
            A website audit demo built around the report, not around the pitch.
          </h1>
          <p
            class="max-w-xl text-[0.98rem] leading-7 text-[color:var(--audit-text-1)] sm:text-lg"
          >
            AuditLab shows how a site reads across privacy, cookies,
            accessibility, and UX, then turns that read into a structured report
            with clear next steps.
          </p>
        </div>

        <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a href="/demo-report" class="audit-btn audit-btn--primary">
            Open demo report
          </a>
          <a
            href="/demo-report/launch-ready"
            class="audit-btn audit-btn--secondary"
          >
            View launch-ready version
          </a>
        </div>

        <p class="max-w-xl text-sm leading-6 text-[color:var(--audit-text-3)]">
          Start with the risk-heavy report, then switch to a cleaner baseline if
          you want to see how the same structure changes in tone.
        </p>
      </div>

      <aside class="space-y-4 lg:pt-6">
        <figure
          class="audit-panel audit-panel--feature p-4 sm:p-5 lg:translate-y-2"
        >
          <div
            class="overflow-hidden rounded-[1.5rem] border border-[color:var(--audit-border-subtle)] bg-[linear-gradient(180deg,rgba(8,13,20,0.92),rgba(5,8,13,0.78))] shadow-[inset_0_1px_0_rgba(255,255,255,0.04)]"
          >
            <picture>
              <source
                type="image/webp"
                srcset="
                  /images/auditlab-visual-1-546.webp   546w,
                  /images/auditlab-visual-1-1092.webp 1092w
                "
                sizes="(min-width: 1024px) 546px, calc(100vw - 3rem)"
              />
              <source
                type="image/png"
                srcset="/images/auditlab-visual-1-546.png 546w"
                sizes="(min-width: 1024px) 546px, calc(100vw - 3rem)"
              />
              <img
                src="/images/auditlab-visual-1-546.png"
                alt="AuditLab report mockup showing a privacy and accessibility audit summary on a dark interface."
                class="block h-auto w-full"
                width="546"
                height="581"
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            </picture>
          </div>
          <figcaption
            class="mt-3 flex items-center justify-between gap-4 text-xs uppercase tracking-[0.24em] text-[color:var(--audit-text-3)]"
          >
            <span>Product mockup</span>
            <span>Report-first visual</span>
          </figcaption>
        </figure>
      </aside>
    </section>

    <section class="audit-section py-8 sm:py-10 lg:py-12">
      <div class="max-w-3xl space-y-3">
        <p class="audit-eyebrow">What the audit looks at</p>
        <h2
          class="text-2xl font-semibold tracking-tight text-[color:var(--audit-text-0)]"
        >
          Four lenses, one report
        </h2>
        <p class="text-sm leading-6 text-[color:var(--audit-text-1)]">
          The demo keeps the scope narrow so the report stays credible and
          readable.
        </p>
      </div>

      <div
        class="mt-5 grid gap-3 sm:mt-6 sm:grid-cols-2 xl:grid-cols-4 sm:gap-4"
      >
        {
          auditFocusAreas.map((area) => (
            <article class="audit-card audit-card--quiet p-4 sm:p-5">
              <p class="text-sm font-medium text-[color:var(--audit-text-0)]">
                {area.label}
              </p>
              <p class="mt-3 text-sm leading-6 text-[color:var(--audit-text-1)]">
                {area.copy}
              </p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="audit-section py-8 sm:py-10 lg:py-12">
      <div class="max-w-3xl space-y-3">
        <p class="audit-eyebrow">How it works</p>
        <h2
          class="text-2xl font-semibold tracking-tight text-[color:var(--audit-text-0)]"
        >
          A short audit flow
        </h2>
      </div>

      <div class="mt-5 grid gap-3 sm:mt-6 lg:grid-cols-3 sm:gap-4">
        {
          auditSteps.map((step) => (
            <article class="audit-card audit-card--quiet p-4 sm:p-5">
              <div class="flex items-center justify-between gap-4">
                <span class="audit-label">{step.step}</span>
                <span class="audit-rule h-px flex-1" aria-hidden="true" />
              </div>
              <h3 class="mt-4 text-lg font-medium text-[color:var(--audit-text-0)]">
                {step.title}
              </h3>
              <p class="mt-3 text-sm leading-6 text-[color:var(--audit-text-1)]">
                {step.copy}
              </p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="audit-section py-8 sm:py-10 lg:py-12">
      <div class="max-w-3xl space-y-3">
        <p class="audit-eyebrow">Sample findings</p>
        <h2
          class="text-2xl font-semibold tracking-tight text-[color:var(--audit-text-0)]"
        >
          A preview of the report tone
        </h2>
        <p class="text-sm leading-6 text-[color:var(--audit-text-1)]">
          These examples match the report language and show how issues are
          framed before you open the full audit.
        </p>
      </div>

      <div class="mt-5 grid gap-3 sm:mt-6 lg:grid-cols-3 sm:gap-4">
        {
          previewFindings.map((finding) => (
            <article class="audit-card audit-card--quiet p-4 sm:p-5">
              <div class="flex items-start justify-between gap-4">
                <div class="space-y-2">
                  <p class="audit-label">Preview issue</p>
                  <h3 class="text-lg font-semibold text-[color:var(--audit-text-0)]">
                    {finding.title}
                  </h3>
                </div>
                <span class={`audit-chip ${severityStyles[finding.severity]}`}>
                  {finding.severity}
                </span>
              </div>
              <p class="mt-4 text-sm leading-6 text-[color:var(--audit-text-1)]">
                {finding.copy}
              </p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="audit-section py-8 sm:py-10 lg:py-12">
      <div class="audit-panel audit-panel--raised p-5 sm:p-7 lg:p-8">
        <div
          class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-center"
        >
          <div class="space-y-3">
            <p class="audit-eyebrow">Explore the report</p>
            <h2
              class="text-2xl font-semibold tracking-tight text-[color:var(--audit-text-0)]"
            >
              The report is the product demo.
            </h2>
            <p
              class="max-w-2xl text-sm leading-6 text-[color:var(--audit-text-1)] sm:text-base"
            >
              If you want the full flow, open the report and move through the
              findings, priority fixes, and handoff section in order.
            </p>
          </div>

          <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
            <a href="/demo-report" class="audit-btn audit-btn--primary">
              Open demo report
            </a>
            <a
              href="/demo-report/launch-ready"
              class="audit-btn audit-btn--secondary"
            >
              Compare launch-ready version
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
