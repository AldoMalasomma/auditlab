---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  showShellHeader?: boolean;
}

const {
  title = 'AuditLab',
  description = 'Audit websites across privacy, cookies, accessibility, and UX clarity.',
  showShellHeader = true,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#03050a" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicons/favicon.svg" />
    <link
      rel="icon"
      type="image/svg+xml"
      sizes="32x32"
      href="/favicons/favicon-32.svg"
    />
    <link rel="apple-touch-icon" href="/favicons/favicon-180.svg" />
    <title>{title}</title>
  </head>
  <body>
    <div class="audit-shell">
      <a
        href="#main-content"
        class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:border focus:border-[color:var(--audit-border-strong)] focus:bg-[color:rgba(7,12,19,0.96)] focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-[color:var(--audit-text-0)]"
      >
        Skip to main content
      </a>
      {
        showShellHeader && (
          <header class="audit-shell__header">
            <details class="group">
              <summary class="audit-frame audit-frame--quiet flex list-none items-center justify-between gap-4 px-4 py-3 sm:px-5 [&::-webkit-details-marker]:hidden group-open:rounded-b-none group-open:border-b-0">
                <a href="/" aria-label="AuditLab home" class="audit-brand">
                  <div class="audit-brand-mark">AL</div>
                  <div class="space-y-0.5">
                    <p class="audit-brand-title">AuditLab</p>
                    <p class="audit-brand-subtitle">Website audit demo</p>
                  </div>
                </a>

                <div class="flex items-center gap-2">
                  <div class="audit-meta hidden sm:inline-flex">
                    Report-first entry point
                  </div>
                  <span class="audit-chip md:hidden">Menu</span>
                </div>
              </summary>

              <nav
                aria-label="Mobile navigation"
                class="audit-frame audit-frame--quiet rounded-t-none border-t-0 px-4 py-3 md:hidden"
              >
                <div class="grid gap-2 text-sm">
                  <a href="/" class="audit-nav-link">
                    {' '}
                    Home{' '}
                  </a>
                  <a href="/demo-report" class="audit-nav-link">
                    {' '}
                    Demo report{' '}
                  </a>
                  <a href="/demo-report/launch-ready" class="audit-nav-link">
                    Launch-ready report
                  </a>
                  <a href="/case" class="audit-nav-link">
                    {' '}
                    Case{' '}
                  </a>
                </div>
              </nav>
            </details>
          </header>
        )
      }
      <slot />
      <footer class="audit-shell__footer">
        <div class="audit-frame audit-frame--quiet px-0 pt-5">
          <div
            class="grid gap-6 px-6 pb-6 text-base leading-7 text-[color:var(--audit-text-2)] md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:grid-cols-[1.1fr_1fr_1.1fr]"
          >
            <div class="space-y-2">
              <a
                href="/"
                aria-label="AuditLab home"
                class="text-base font-medium text-[color:var(--audit-text-1)] transition hover:text-[color:var(--audit-text-0)]"
              >
                AuditLab
              </a>
              <p
                class="max-w-xs text-sm leading-6 text-[color:var(--audit-text-3)]"
              >
                Fictional SaaS demo for privacy, cookies, accessibility, and UX
                audits.
              </p>
            </div>

            <div class="space-y-2">
              <p class="audit-label">Explore</p>
              <nav aria-label="Footer explore" class="grid gap-2 text-sm">
                <a
                  href="/"
                  class="transition hover:text-[color:var(--audit-text-0)]"
                >
                  Home
                </a>
                <a
                  href="/demo-report"
                  class="transition hover:text-[color:var(--audit-text-0)]"
                >
                  Demo report
                </a>
                <a
                  href="/demo-report/launch-ready"
                  class="transition hover:text-[color:var(--audit-text-0)]"
                >
                  Launch-ready report
                </a>
                <a
                  href="/case"
                  class="transition hover:text-[color:var(--audit-text-0)]"
                >
                  Case
                </a>
              </nav>
            </div>

            <div class="space-y-3 text-xs">
              <div class="space-y-2">
                <p class="audit-label">Policies</p>
                <nav aria-label="Footer policies" class="grid gap-2 text-sm">
                  <a
                    href="/privacy"
                    class="transition hover:text-[color:var(--audit-text-0)]"
                  >
                    Privacy
                  </a>
                  <a
                    href="/cookies"
                    class="transition hover:text-[color:var(--audit-text-0)]"
                  >
                    Cookies
                  </a>
                  <a
                    href="/accessibility"
                    class="transition hover:text-[color:var(--audit-text-0)]"
                  >
                    Accessibility
                  </a>
                  <a
                    href="/terms"
                    class="transition hover:text-[color:var(--audit-text-0)]"
                  >
                    Terms
                  </a>
                  <a
                    href="/portfolio-disclosure"
                    class="transition hover:text-[color:var(--audit-text-0)]"
                  >
                    Portfolio disclosure
                  </a>
                </nav>
              </div>

              <div class="space-y-2">
                <p class="text-sm leading-6 text-[color:var(--audit-text-3)]">
                  Portfolio owner:
                  <a
                    href="https://copycodeai.online"
                    class="transition hover:text-[color:var(--audit-text-0)]"
                  >
                    copycodeai.online
                  </a>
                  ·
                  <a
                    href="mailto:hello@copycodeai.online"
                    class="transition hover:text-[color:var(--audit-text-0)]"
                  >
                    hello@copycodeai.online
                  </a>
                </p>
                <p class="text-sm leading-6 text-[color:var(--audit-text-3)]">
                  Built with Astro, Tailwind, TypeScript, static local data, and
                  reusable components.
                </p>
              </div>
            </div>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
