---
import type { DemoReportData } from '../../data/demo-report';

interface Props {
  report: Pick<
    DemoReportData,
    | 'narrativeHeading'
    | 'narrativeBody'
    | 'narrativeNote'
    | 'comparisonLabel'
    | 'comparisonHref'
  >;
}

const { report } = Astro.props;
---

<section
  aria-labelledby="report-narrative-heading"
  class="audit-section audit-report-surface audit-panel audit-panel--inset p-5 sm:p-6"
>
  <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_18rem] lg:items-start">
    <div class="space-y-3">
      <p class="audit-eyebrow">Current read</p>
      <h2
        id="report-narrative-heading"
        class="max-w-3xl text-xl font-semibold tracking-[-0.03em] text-[color:var(--audit-text-0)] sm:text-2xl"
      >
        {report.narrativeHeading}
      </h2>
      <p
        class="max-w-3xl text-sm leading-7 text-[color:var(--audit-text-1)] sm:text-base"
      >
        {report.narrativeBody}
      </p>
    </div>

    <div class="audit-card audit-card--quiet p-4">
      <p class="audit-label">Transition</p>
      <p class="mt-2 text-sm leading-6 text-[color:var(--audit-text-1)]">
        {report.narrativeNote}
      </p>
      <a
        href={report.comparisonHref}
        class="mt-3 inline-flex text-sm font-medium text-[color:var(--audit-text-0)] underline decoration-[color:var(--audit-border-subtle)] underline-offset-4 transition hover:decoration-[color:var(--audit-text-0)]"
      >
        {report.comparisonLabel}
      </a>
    </div>
  </div>
</section>
