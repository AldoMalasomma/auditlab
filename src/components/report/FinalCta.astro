---
import type { DemoReportData } from '../../data/demo-report';

interface Props {
  cta: DemoReportData['finalCta'];
}

const { cta } = Astro.props;
---

<section
  class="audit-section audit-report-cta audit-panel audit-panel--feature p-5 sm:p-7 lg:p-8"
>
  <div class="space-y-4">
    <p class="audit-eyebrow">Next step</p>
    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-start">
      <div class="space-y-3">
        <h2
          class="text-[1.35rem] font-semibold tracking-[-0.03em] text-[color:var(--audit-text-0)] sm:text-3xl"
        >
          {cta.title}
        </h2>
        <p
          class="max-w-2xl text-[0.92rem] leading-6 text-[color:var(--audit-text-1)] sm:text-base"
        >
          {cta.description}
        </p>
      </div>

      <div class="audit-report-action__rail audit-panel audit-panel--inset p-4">
        <p class="audit-label">What happens next</p>
        <p
          class="mt-2 text-[0.92rem] leading-6 text-[color:var(--audit-text-1)]"
        >
          A follow-up review, a short fix plan, or a walkthrough of the highest
          priority items. No pressure and no form flow in this demo.
        </p>
      </div>
    </div>

    <div class="grid gap-3 sm:grid-cols-3">
      {
        cta.nextSteps.map((step) => (
          <a
            href={step.href}
            class="audit-report-cta__link audit-card audit-card--quiet p-4"
          >
            <p class="text-[0.96rem] font-medium tracking-[-0.02em] text-[color:var(--audit-text-0)]">
              {step.label}
            </p>
            <p class="mt-2 text-[0.9rem] leading-6 text-[color:var(--audit-text-1)]">
              {step.description}
            </p>
          </a>
        ))
      }
    </div>

    <div
      class="audit-rule flex flex-col gap-3 pt-4 sm:flex-row sm:items-center sm:justify-between"
    >
      <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a href={cta.primaryHref} class="audit-btn audit-btn--primary">
          {cta.primaryLabel}
        </a>
        <a href={cta.secondaryHref} class="audit-btn audit-btn--secondary">
          {cta.secondaryLabel}
        </a>
      </div>

      <p class="max-w-xl text-xs leading-5 text-[color:var(--audit-text-3)]">
        {cta.trustLine}
      </p>
    </div>
  </div>
</section>
