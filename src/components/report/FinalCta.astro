---
import type { DemoReportData } from '../../data/demo-report';

interface Props {
  cta: DemoReportData['finalCta'];
}

const { cta } = Astro.props;
---

<section
  class="rounded-[2rem] border border-white/10 bg-[linear-gradient(135deg,rgba(143,183,255,0.14),rgba(255,255,255,0.04))] p-6 shadow-2xl shadow-slate-950/30 sm:p-7 lg:p-8"
>
  <div class="space-y-4">
    <p class="text-xs uppercase tracking-[0.3em] text-slate-400">Next step</p>
    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-start">
      <div class="space-y-3">
        <h2
          class="text-2xl font-semibold tracking-tight text-slate-50 sm:text-3xl"
        >
          {cta.title}
        </h2>
        <p class="max-w-2xl text-sm leading-6 text-slate-300 sm:text-base">
          {cta.description}
        </p>
      </div>

      <div class="rounded-3xl border border-white/10 bg-slate-950/70 p-4">
        <p class="text-xs uppercase tracking-[0.24em] text-slate-400">
          What happens next
        </p>
        <p class="mt-2 text-sm leading-6 text-slate-300">
          A follow-up review, a short fix plan, or a walkthrough of the highest
          priority items. No pressure and no form flow in this demo.
        </p>
      </div>
    </div>

    <div class="grid gap-3 md:grid-cols-3">
      {
        cta.nextSteps.map((step) => (
          <a
            href={step.href}
            class="rounded-3xl border border-white/10 bg-white/5 p-4 transition hover:border-white/20 hover:bg-white/8"
          >
            <p class="text-sm font-medium text-slate-50">{step.label}</p>
            <p class="mt-2 text-sm leading-6 text-slate-300">
              {step.description}
            </p>
          </a>
        ))
      }
    </div>

    <div
      class="flex flex-col gap-3 border-t border-white/10 pt-4 sm:flex-row sm:items-center sm:justify-between"
    >
      <div class="flex flex-col gap-3 sm:flex-row">
        <a
          href={cta.primaryHref}
          class="inline-flex items-center justify-center rounded-full bg-slate-100 px-5 py-3 text-sm font-semibold text-slate-950 transition hover:bg-white"
        >
          {cta.primaryLabel}
        </a>
        <a
          href={cta.secondaryHref}
          class="inline-flex items-center justify-center rounded-full border border-white/10 bg-white/5 px-5 py-3 text-sm font-semibold text-slate-100 transition hover:bg-white/10"
        >
          {cta.secondaryLabel}
        </a>
      </div>

      <p class="max-w-xl text-xs leading-5 text-slate-400">
        {cta.trustLine}
      </p>
    </div>
  </div>
</section>
