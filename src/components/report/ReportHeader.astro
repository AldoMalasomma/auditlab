---
import type { DemoReportData } from '../../data/demo-report';

interface Props {
  report: Pick<
    DemoReportData,
    | 'domain'
    | 'auditDate'
    | 'variantLabel'
    | 'overallScore'
    | 'scoreInterpretation'
    | 'scoreContext'
    | 'statusLabel'
    | 'statusSummary'
  >;
}

const { report } = Astro.props;

const statusClasses = {
  'Action required': 'audit-meta--status-warning',
  'Mostly ready': 'audit-meta--status-success',
  Healthy: 'audit-meta--status-success',
};

const statusClass =
  statusClasses[report.statusLabel as keyof typeof statusClasses] ??
  'audit-meta--status';
---

<header
  class="audit-report-hero audit-frame grid gap-5 p-5 sm:p-7 lg:grid-cols-[minmax(0,1fr)_20rem] lg:p-8"
>
  <div class="space-y-4 sm:space-y-5">
    <div class="flex flex-wrap items-center gap-2.5 sm:gap-3">
      <p class="audit-eyebrow">Demo report</p>
      <span class="audit-meta">
        {report.variantLabel}
      </span>
      <span class={`audit-meta audit-meta--status ${statusClass}`}>
        {report.statusLabel}
      </span>
    </div>

    <div class="space-y-3">
      <h1
        class="max-w-3xl text-[2.15rem] font-semibold tracking-[-0.04em] text-balance leading-[0.98] text-[color:var(--audit-text-0)] sm:text-4xl"
      >
        {report.domain}
      </h1>
      <p
        class="max-w-3xl text-[0.98rem] leading-7 text-[color:var(--audit-text-1)] sm:text-lg"
      >
        {report.statusSummary}
      </p>
    </div>

    <dl class="grid gap-3 sm:grid-cols-2 sm:gap-4">
      <div class="audit-card audit-card--quiet p-4">
        <dt class="audit-label">Audited domain</dt>
        <dd class="mt-2 text-lg font-medium text-[color:var(--audit-text-0)]">
          {report.domain}
        </dd>
      </div>
      <div class="audit-card audit-card--quiet p-4">
        <dt class="audit-label">Audit date</dt>
        <dd class="mt-2 text-lg font-medium text-[color:var(--audit-text-0)]">
          {report.auditDate}
        </dd>
      </div>
    </dl>
  </div>

  <aside class="audit-report-score audit-panel audit-panel--inset p-4 sm:p-5">
    <p class="audit-report-score__meta">Overall score</p>
    <div class="mt-4 flex flex-col gap-4 sm:flex-row sm:items-start">
      <div class="audit-report-score__figure" aria-hidden="true">
        <div class="audit-report-score__figure-inner">
          <span
            class="audit-stat text-[2.15rem] font-semibold leading-none text-[color:var(--audit-text-0)] sm:text-4xl"
          >
            {report.overallScore}
          </span>
        </div>
      </div>
      <div class="space-y-2 pt-0 sm:pt-1">
        <p class="text-sm text-[color:var(--audit-text-3)]">/ 100</p>
        <p
          class="mt-2 text-xs uppercase tracking-[0.22em] text-[color:var(--audit-text-2)]"
        >
          Audit baseline
        </p>
      </div>
    </div>
    <p class="audit-report-score__interpretation mt-4 font-medium">
      {report.scoreInterpretation}
    </p>
    <p class="audit-report-score__context mt-2">
      {report.scoreContext}
    </p>
  </aside>
</header>
