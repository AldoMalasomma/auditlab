---
import type { DemoReportData } from '../../data/demo-report';

interface Props {
  report: Pick<
    DemoReportData,
    | 'domain'
    | 'auditDate'
    | 'variantLabel'
    | 'overallScore'
    | 'scoreInterpretation'
    | 'scoreContext'
    | 'statusLabel'
    | 'statusSummary'
  >;
}

const { report } = Astro.props;

const statusClasses = {
  'Action required': 'border-amber-400/25 bg-amber-400/10 text-amber-100',
  'Mostly ready': 'border-emerald-400/25 bg-emerald-400/10 text-emerald-100',
  Healthy: 'border-emerald-400/25 bg-emerald-400/10 text-emerald-100',
};

const statusClass =
  statusClasses[report.statusLabel as keyof typeof statusClasses] ??
  'border-sky-400/25 bg-sky-400/10 text-sky-100';
---

<header
  class="grid gap-6 rounded-[2rem] border border-white/10 bg-white/5 p-6 shadow-2xl shadow-slate-950/30 backdrop-blur sm:p-7 lg:grid-cols-[minmax(0,1fr)_20rem] lg:p-8"
>
  <div class="space-y-4">
    <div class="flex flex-wrap items-center gap-3">
      <p class="text-xs uppercase tracking-[0.28em] text-slate-400">
        Demo report
      </p>
      <span
        class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-medium text-slate-200"
      >
        {report.variantLabel}
      </span>
      <span
        class={`rounded-full border px-3 py-1 text-xs font-medium ${statusClass}`}
      >
        {report.statusLabel}
      </span>
    </div>

    <div class="space-y-3">
      <h1
        class="max-w-3xl text-3xl font-semibold tracking-tight text-balance text-slate-50 sm:text-4xl"
      >
        {report.domain}
      </h1>
      <p class="max-w-3xl text-base leading-7 text-slate-300 sm:text-lg">
        {report.statusSummary}
      </p>
    </div>

    <dl class="grid gap-4 sm:grid-cols-2">
      <div class="rounded-3xl border border-white/10 bg-slate-950/60 p-4">
        <dt class="text-xs uppercase tracking-[0.24em] text-slate-400">
          Audited domain
        </dt>
        <dd class="mt-2 text-lg font-medium text-slate-100">{report.domain}</dd>
      </div>
      <div class="rounded-3xl border border-white/10 bg-slate-950/60 p-4">
        <dt class="text-xs uppercase tracking-[0.24em] text-slate-400">
          Audit date
        </dt>
        <dd class="mt-2 text-lg font-medium text-slate-100">
          {report.auditDate}
        </dd>
      </div>
    </dl>
  </div>

  <aside class="rounded-3xl border border-white/10 bg-slate-950/70 p-5">
    <p class="text-xs uppercase tracking-[0.3em] text-slate-400">
      Overall score
    </p>
    <div class="mt-4 flex items-end gap-3">
      <span class="text-5xl font-semibold tracking-tight text-slate-50">
        {report.overallScore}
      </span>
      <span class="pb-1 text-sm text-slate-400">/ 100</span>
    </div>
    <p class="mt-4 text-sm font-medium leading-6 text-slate-100">
      {report.scoreInterpretation}
    </p>
    <p class="mt-2 text-sm leading-6 text-slate-300">
      {report.scoreContext}
    </p>
  </aside>
</header>
