---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FinalCta from './FinalCta.astro';
import FindingsList from './FindingsList.astro';
import PriorityFixes from './PriorityFixes.astro';
import ReportNarrative from './ReportNarrative.astro';
import ReportHeader from './ReportHeader.astro';
import ScoreCards from './ScoreCards.astro';
import type { DemoReportData, ReportToggleLink } from '../../data/demo-report';

interface Props {
  report: DemoReportData;
  switchLink: ReportToggleLink;
}

const { report, switchLink } = Astro.props;

const pageTitle = `${report.domain} | AuditLab`;
const pageDescription = `${report.variantLabel} for ${report.domain}. ${report.statusSummary}`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  showShellHeader={false}
>
  <main
    id="main-content"
    tabindex="-1"
    class="audit-report-shell mx-auto flex min-h-screen w-full max-w-7xl flex-col gap-5 px-4 py-4 sm:px-8 sm:py-6 lg:px-10 lg:gap-8"
  >
    <header
      id="top"
      class="audit-report-topbar audit-frame audit-frame--quiet flex flex-col gap-3 px-4 py-3 sm:flex-row sm:flex-wrap sm:items-center sm:justify-between"
    >
      <a href="/" aria-label="AuditLab home" class="audit-brand">
        <div class="audit-brand-mark">AL</div>
        <div class="space-y-0.5">
          <p class="audit-brand-title">AuditLab</p>
          <p class="audit-brand-subtitle">Demo report</p>
        </div>
      </a>

      <div class="flex flex-wrap items-center gap-2">
        <span class="audit-meta">
          {report.variantLabel}
        </span>
        <a
          href={switchLink.href}
          class="audit-chip audit-chip--strong audit-chip--action"
        >
          {switchLink.label}
        </a>
        <a href="/" class="audit-chip audit-chip--action"> Back to overview </a>
      </div>
    </header>

    <ReportHeader report={report} />

    <ReportNarrative report={report} />

    <ScoreCards cards={report.categoryScores} />

    <div
      class="grid gap-5 xl:grid-cols-[minmax(0,1fr)_24rem] xl:items-start sm:gap-6"
    >
      <FindingsList findings={report.findings} />
      <PriorityFixes fixes={report.priorityFixes} />
    </div>

    <FinalCta cta={report.finalCta} />
  </main>
</BaseLayout>
