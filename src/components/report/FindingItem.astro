---
import type { Finding } from '../../data/demo-report';

interface Props {
  finding: Finding;
}

const { finding } = Astro.props;

const severityStyles = {
  high: {
    card: 'border-l-[color:var(--audit-danger)]',
    badge: 'audit-meta--status-danger',
  },
  medium: {
    card: 'border-l-[color:var(--audit-warning)]',
    badge: 'audit-meta--status-warning',
  },
  low: {
    card: 'border-l-[color:var(--audit-accent)]',
    badge: 'audit-meta--status-success',
  },
};
---

<article
  class={`audit-report-finding audit-card border-l-4 p-4 sm:p-5 ${severityStyles[finding.severity].card}`}
>
  <div
    class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between sm:gap-4"
  >
    <div class="space-y-2">
      <p class="audit-label">
        {finding.category}
      </p>
      <h3
        class="text-[1.05rem] font-semibold tracking-[-0.02em] text-[color:var(--audit-text-0)] sm:text-lg"
      >
        {finding.issue}
      </h3>
    </div>

    <span
      class={`audit-meta audit-meta--status ${severityStyles[finding.severity].badge} self-start`}
    >
      {finding.severity} severity
    </span>
  </div>

  <div class="mt-4 space-y-4">
    <div class="audit-report-finding__topline" aria-hidden="true"></div>
    <dl class="grid gap-3 sm:grid-cols-2 sm:gap-4">
      <div class="audit-report-finding__panel audit-card audit-card--quiet p-4">
        <dt class="audit-label">Why it matters</dt>
        <dd
          class="mt-2 text-[0.92rem] leading-6 text-[color:var(--audit-text-1)]"
        >
          {finding.whyItMatters}
        </dd>
      </div>
      <div class="audit-report-finding__panel audit-card audit-card--quiet p-4">
        <dt class="audit-label">Suggested action</dt>
        <dd
          class="mt-2 text-[0.92rem] leading-6 text-[color:var(--audit-text-0)]"
        >
          {finding.suggestedAction}
        </dd>
      </div>
    </dl>
  </div>
</article>
