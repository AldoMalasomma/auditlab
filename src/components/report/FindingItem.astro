---
import type { Finding } from '../../data/demo-report';

interface Props {
  finding: Finding;
}

const { finding } = Astro.props;

const severityStyles = {
  high: {
    card: 'border-l-rose-400/70',
    badge: 'border-rose-400/20 bg-rose-400/10 text-rose-100',
  },
  medium: {
    card: 'border-l-amber-400/70',
    badge: 'border-amber-400/20 bg-amber-400/10 text-amber-100',
  },
  low: {
    card: 'border-l-sky-400/70',
    badge: 'border-sky-400/20 bg-sky-400/10 text-sky-100',
  },
};
---

<article
  class={`rounded-[1.75rem] border border-white/10 border-l-4 bg-slate-950/70 p-5 ${severityStyles[finding.severity].card}`}
>
  <div class="flex items-start justify-between gap-4">
    <div class="space-y-2">
      <p class="text-xs uppercase tracking-[0.24em] text-slate-500">
        {finding.category}
      </p>
      <h3 class="text-lg font-semibold text-slate-50">{finding.issue}</h3>
    </div>

    <span
      class={`rounded-full border px-3 py-1 text-xs font-medium uppercase tracking-[0.22em] ${severityStyles[finding.severity].badge}`}
    >
      {finding.severity} severity
    </span>
  </div>

  <div class="mt-4 space-y-4 border-t border-white/10 pt-4">
    <dl class="grid gap-4 sm:grid-cols-2">
      <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4">
        <dt class="text-xs uppercase tracking-[0.24em] text-slate-400">
          Why it matters
        </dt>
        <dd class="mt-2 text-sm leading-6 text-slate-300">
          {finding.whyItMatters}
        </dd>
      </div>
      <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4">
        <dt class="text-xs uppercase tracking-[0.24em] text-slate-400">
          Suggested action
        </dt>
        <dd class="mt-2 text-sm leading-6 text-slate-200">
          {finding.suggestedAction}
        </dd>
      </div>
    </dl>
  </div>
</article>
