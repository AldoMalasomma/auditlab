---
import type { CategoryScore } from '../../data/demo-report';

interface Props {
  cards: CategoryScore[];
}

const { cards } = Astro.props;
---

<section aria-labelledby="category-scores" class="audit-section space-y-4">
  <div class="flex items-end justify-between gap-4">
    <div>
      <p class="audit-eyebrow">Category scores</p>
      <h2
        id="category-scores"
        class="mt-2 text-xl font-semibold text-[color:var(--audit-text-0)]"
      >
        Audit lens scorecard
      </h2>
    </div>
    <p class="hidden text-sm text-[color:var(--audit-text-2)] sm:block">
      Use this as the quick read. The findings below explain the score in
      detail.
    </p>
  </div>

  <ul class="grid gap-3 sm:grid-cols-2 sm:gap-4 xl:grid-cols-4">
    {
      cards.map((card) => (
        <li class="audit-report-scorecard audit-card p-4 sm:p-5">
          <div class="flex items-start justify-between gap-4">
            <div class="space-y-2">
              <p class="text-sm font-medium text-[color:var(--audit-text-0)]">
                {card.label}
              </p>
              <p class="audit-label">{card.status}</p>
            </div>
            <span class="audit-stat text-3xl font-semibold text-[color:var(--audit-text-0)]">
              {card.score}
            </span>
          </div>
          <p class="mt-4 text-sm leading-6 text-[color:var(--audit-text-1)]">
            {card.summary}
          </p>
        </li>
      ))
    }
  </ul>
</section>
