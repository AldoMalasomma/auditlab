---
import type { PriorityFix } from '../../data/demo-report';

interface Props {
  fixes: PriorityFix[];
}

const { fixes } = Astro.props;
---

<aside
  id="priority-fixes"
  aria-labelledby="priority-fixes-heading"
  class="rounded-[2rem] border border-white/10 bg-slate-950/75 p-6 shadow-2xl shadow-slate-950/25 sm:p-7 lg:p-8"
>
  <div class="space-y-3">
    <p class="text-xs uppercase tracking-[0.3em] text-slate-400">Fix first</p>
    <h2
      id="priority-fixes-heading"
      class="text-2xl font-semibold tracking-tight text-slate-50"
    >
      Highest leverage actions
    </h2>
    <p class="text-sm leading-6 text-slate-300">
      These are the first moves after the findings review. The top two change
      the trust story fastest; the third closes the remaining polish gap.
    </p>
  </div>

  <ol class="mt-6 space-y-4">
    {
      fixes.map((fix, index) => (
        <li
          class={`rounded-[1.5rem] border p-4 ${
            index < 2
              ? 'border-sky-400/20 bg-sky-400/10'
              : 'border-white/10 bg-white/5'
          }`}
        >
          <div class="flex gap-4">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-white/10 bg-slate-900 text-sm font-semibold text-slate-100">
              {index + 1}
            </span>
            <div class="space-y-3">
              <div>
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="font-medium text-slate-50">{fix.title}</h3>
                  <span class="rounded-full border border-white/10 bg-white/5 px-2.5 py-1 text-[11px] font-medium uppercase tracking-[0.22em] text-slate-300">
                    Impact: {fix.impact}
                  </span>
                  <span class="rounded-full border border-white/10 bg-white/5 px-2.5 py-1 text-[11px] font-medium uppercase tracking-[0.22em] text-slate-300">
                    Effort: {fix.effort}
                  </span>
                </div>
                <p class="mt-2 text-sm leading-6 text-slate-300">
                  {fix.reason}
                </p>
              </div>
              <p class="text-sm leading-6 text-slate-200">
                <span class="font-medium text-slate-50">Expected outcome:</span>{' '}
                {fix.outcome}
              </p>
            </div>
          </div>
        </li>
      ))
    }
  </ol>
</aside>
