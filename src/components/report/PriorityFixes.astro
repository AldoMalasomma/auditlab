---
import type { PriorityFix } from '../../data/demo-report';

interface Props {
  fixes: PriorityFix[];
}

const { fixes } = Astro.props;
---

<aside
  id="priority-fixes"
  aria-labelledby="priority-fixes-heading"
  class="audit-section audit-report-priority audit-panel audit-panel--raised p-5 sm:p-7 lg:p-8"
>
  <div class="space-y-3">
    <p class="audit-eyebrow">Fix first</p>
    <h2
      id="priority-fixes-heading"
      class="text-[1.35rem] font-semibold tracking-[-0.03em] text-[color:var(--audit-text-0)] sm:text-2xl"
    >
      Highest leverage actions
    </h2>
    <p class="text-sm leading-6 text-[color:var(--audit-text-1)]">
      These are the first moves after the findings review. The top two change
      the trust story fastest; the third closes the remaining polish gap.
    </p>
  </div>

  <ol class="mt-6 space-y-3.5 sm:space-y-4">
    {
      fixes.map((fix, index) => (
        <li
          class={`audit-report-priority__item audit-card p-4 ${
            index < 2
              ? 'audit-card--raised audit-report-priority__item--featured'
              : 'audit-card--quiet'
          }`}
        >
          <div class="flex flex-col gap-3 sm:flex-row sm:gap-4">
            <span class="audit-report-action__number audit-stat shrink-0">
              {index + 1}
            </span>
            <div class="space-y-3">
              <div class="space-y-2">
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="text-[1.02rem] font-medium tracking-[-0.02em] text-[color:var(--audit-text-0)]">
                    {fix.title}
                  </h3>
                  <span class="audit-meta text-[11px]">
                    Impact: {fix.impact}
                  </span>
                  <span class="audit-meta text-[11px]">
                    Effort: {fix.effort}
                  </span>
                </div>
                <p class="text-[0.92rem] leading-6 text-[color:var(--audit-text-1)]">
                  {fix.reason}
                </p>
              </div>
              <p class="text-[0.92rem] leading-6 text-[color:var(--audit-text-1)]">
                <span class="font-medium text-[color:var(--audit-text-0)]">
                  Expected outcome:
                </span>{' '}
                {fix.outcome}
              </p>
            </div>
          </div>
        </li>
      ))
    }
  </ol>
</aside>
