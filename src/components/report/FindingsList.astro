---
import type { Finding, Severity } from '../../data/demo-report';
import FindingItem from './FindingItem.astro';

interface Props {
  findings: Finding[];
}

const { findings } = Astro.props;

const severityOrder: Severity[] = ['high', 'medium', 'low'];
const severityLabels: Record<Severity, string> = {
  high: 'High severity',
  medium: 'Medium severity',
  low: 'Low severity',
};

const groupedFindings = severityOrder.map((severity) => ({
  severity,
  findings: findings.filter((finding) => finding.severity === severity),
}));
---

<section
  id="findings"
  aria-labelledby="findings-heading"
  class="audit-section audit-report-findings audit-panel audit-panel--raised p-5 sm:p-7 lg:p-8"
>
  <div class="max-w-3xl space-y-3">
    <p class="audit-eyebrow">Findings</p>
    <h2
      id="findings-heading"
      class="text-[1.35rem] font-semibold tracking-[-0.03em] text-[color:var(--audit-text-0)] sm:text-2xl"
    >
      Findings ordered by trust impact
    </h2>
    <p class="text-sm leading-6 text-[color:var(--audit-text-1)]">
      The higher-risk items come first because they explain why the score lands
      where it does. The remaining notes are the launch polish that still
      matters.
    </p>
  </div>

  <div class="mt-5 flex flex-wrap gap-2">
    {
      severityOrder.map((severity) => (
        <span class="audit-meta">{severityLabels[severity]}</span>
      ))
    }
  </div>

  <div class="mt-6 space-y-5 sm:space-y-6">
    {
      groupedFindings.map(
        ({ severity, findings }) =>
          findings.length > 0 && (
            <section aria-labelledby={`severity-${severity}`} class="space-y-4">
              <div class="flex items-center justify-between gap-4">
                <h3
                  id={`severity-${severity}`}
                  class="audit-label font-semibold"
                >
                  {severityLabels[severity]}
                </h3>
                <span class="text-sm text-[color:var(--audit-text-3)]">
                  {findings.length} items
                </span>
              </div>

              <ul class="grid gap-4">
                {findings.map((finding) => (
                  <li>
                    <FindingItem finding={finding} />
                  </li>
                ))}
              </ul>
            </section>
          ),
      )
    }
  </div>
</section>
