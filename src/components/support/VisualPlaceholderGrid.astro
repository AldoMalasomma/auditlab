---
interface VisualSlot {
  label: string;
  title: string;
  caption: string;
}

interface Props {
  items: VisualSlot[];
}

const { items } = Astro.props;
---

<div class="grid gap-4 lg:grid-cols-3">
  {
    items.map((item) => (
      <figure class="rounded-[1.75rem] border border-white/10 bg-white/5 p-4">
        <div class="aspect-[16/10] rounded-[1.5rem] border border-dashed border-white/10 bg-[linear-gradient(180deg,rgba(255,255,255,0.03),rgba(255,255,255,0.01))] p-3">
          <div class="flex h-full items-center justify-center rounded-[1.25rem] border border-white/5 bg-slate-950/70">
            <div class="space-y-2 text-center">
              <p class="text-[11px] uppercase tracking-[0.3em] text-slate-500">
                {item.label}
              </p>
              <p class="text-sm text-slate-300">Insert product visual here</p>
            </div>
          </div>
        </div>
        <figcaption class="mt-3 space-y-1">
          <p class="text-sm font-medium text-slate-50">{item.title}</p>
          <p class="text-sm leading-6 text-slate-300">{item.caption}</p>
        </figcaption>
      </figure>
    ))
  }
</div>
