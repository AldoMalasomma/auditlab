---
interface VisualSlot {
  label: string;
  title: string;
  caption: string;
}

interface Props {
  items: VisualSlot[];
}

const { items } = Astro.props;
---

<div class="grid gap-4 lg:grid-cols-3">
  {
    items.map((item) => (
      <figure class="audit-card audit-card--quiet p-4">
        <div class="aspect-[16/10] rounded-[1.5rem] border border-dashed border-[color:var(--audit-border-subtle)] bg-[linear-gradient(180deg,rgba(255,255,255,0.03),rgba(255,255,255,0.01))] p-3">
          <div class="flex h-full items-center justify-center rounded-[1.25rem] border border-[color:var(--audit-border-subtle)] bg-[linear-gradient(180deg,rgba(8,13,20,0.92),rgba(5,8,13,0.78))]">
            <div class="space-y-2 text-center">
              <p class="audit-label text-[11px]">{item.label}</p>
              <p class="text-sm text-[color:var(--audit-text-1)]">
                Insert product visual here
              </p>
            </div>
          </div>
        </div>
        <figcaption class="mt-3 space-y-1">
          <p class="text-sm font-medium text-[color:var(--audit-text-0)]">
            {item.title}
          </p>
          <p class="text-sm leading-6 text-[color:var(--audit-text-1)]">
            {item.caption}
          </p>
        </figcaption>
      </figure>
    ))
  }
</div>
