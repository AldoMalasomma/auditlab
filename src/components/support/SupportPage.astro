---
import BaseLayout from '../../layouts/BaseLayout.astro';

interface SupportSection {
  title: string;
  paragraphs: string[];
  bullets?: string[];
}

interface SupportLink {
  label: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  intro: string;
  backHref: string;
  backLabel: string;
  sections: SupportSection[];
  sidebarTitle: string;
  sidebarIntro: string;
  sidebarPoints: string[];
  contactTitle: string;
  contactLinks: SupportLink[];
  portfolioNote: string;
}

const {
  title,
  description,
  eyebrow,
  intro,
  backHref,
  backLabel,
  sections,
  sidebarTitle,
  sidebarIntro,
  sidebarPoints,
  contactTitle,
  contactLinks,
  portfolioNote,
} = Astro.props;
---

<BaseLayout title={title} description={description}>
  <main
    id="main-content"
    tabindex="-1"
    class="mx-auto flex min-h-screen w-full max-w-5xl flex-col px-6 py-6 sm:px-8 lg:px-10"
  >
    <header
      class="flex items-center justify-between border-b border-white/10 pb-4"
    >
      <div>
        <p class="text-xs uppercase tracking-[0.3em] text-slate-400">
          {eyebrow}
        </p>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight text-slate-50">
          {title}
        </h1>
      </div>

      <a
        href={backHref}
        class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-medium uppercase tracking-[0.22em] text-slate-300 transition hover:bg-white/10 hover:text-white"
      >
        {backLabel}
      </a>
    </header>

    <section
      class="grid gap-6 py-10 lg:grid-cols-[minmax(0,1fr)_18rem] lg:items-start"
    >
      <div class="space-y-6">
        <div
          class="rounded-[2rem] border border-white/10 bg-white/5 p-6 sm:p-7"
        >
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-sm uppercase tracking-[0.3em] text-slate-400">
              Static support page
            </span>
            <span
              class="rounded-full border border-white/10 bg-slate-950/70 px-3 py-1 text-xs font-medium uppercase tracking-[0.22em] text-slate-300"
            >
              Portfolio demo
            </span>
          </div>
          <p class="mt-4 max-w-2xl text-lg leading-8 text-slate-300">
            {intro}
          </p>
          <p class="mt-4 max-w-2xl text-sm leading-6 text-slate-500">
            {portfolioNote}
          </p>
        </div>

        <div class="grid gap-4">
          {
            sections.map((section) => (
              <article class="rounded-[2rem] border border-white/10 bg-slate-950/65 p-6 sm:p-7">
                <h2 class="text-xl font-semibold text-slate-50">
                  {section.title}
                </h2>
                <div class="mt-4 space-y-4 text-base leading-7 text-slate-300">
                  {section.paragraphs.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                </div>
                {section.bullets && (
                  <ul class="mt-5 grid gap-3">
                    {section.bullets.map((bullet) => (
                      <li class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-base leading-7 text-slate-300">
                        {bullet}
                      </li>
                    ))}
                  </ul>
                )}
              </article>
            ))
          }
        </div>
      </div>

      <aside
        class="space-y-4 rounded-[2rem] border border-white/10 bg-white/5 p-6 shadow-2xl shadow-slate-950/30"
      >
        <div>
          <p class="text-sm uppercase tracking-[0.3em] text-slate-400">
            {sidebarTitle}
          </p>
          <p class="mt-2 text-base leading-7 text-slate-300">{sidebarIntro}</p>
        </div>

        <div>
          <p class="text-sm uppercase tracking-[0.28em] text-slate-500">
            Scope notes
          </p>
          <ul class="mt-4 space-y-2">
            {
              sidebarPoints.map((point) => (
                <li class="rounded-2xl border border-white/10 bg-slate-950/60 px-4 py-3 text-base leading-7 text-slate-200">
                  {point}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="rounded-2xl border border-white/10 bg-slate-950/60 p-4">
          <p class="text-sm uppercase tracking-[0.28em] text-slate-500">
            {contactTitle}
          </p>
          <ul class="mt-3 space-y-2 text-base leading-7 text-slate-300">
            {
              contactLinks.map((link) => (
                <li>
                  <a href={link.href} class="transition hover:text-white">
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </section>
  </main>
</BaseLayout>
