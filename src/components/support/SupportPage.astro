---
import BaseLayout from '../../layouts/BaseLayout.astro';

interface SupportSection {
  title: string;
  paragraphs: string[];
  bullets?: string[];
}

interface SupportLink {
  label: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  intro: string;
  backHref: string;
  backLabel: string;
  sections: SupportSection[];
  sidebarTitle: string;
  sidebarIntro: string;
  sidebarPoints: string[];
  contactTitle: string;
  contactLinks: SupportLink[];
  portfolioNote: string;
}

const {
  title,
  description,
  eyebrow,
  intro,
  backHref,
  backLabel,
  sections,
  sidebarTitle,
  sidebarIntro,
  sidebarPoints,
  contactTitle,
  contactLinks,
  portfolioNote,
} = Astro.props;
---

<BaseLayout title={title} description={description} showShellHeader={false}>
  <main
    id="main-content"
    tabindex="-1"
    class="mx-auto flex min-h-screen w-full max-w-7xl flex-col px-4 py-4 sm:px-8 sm:py-6 lg:px-10"
  >
    <header
      class="audit-frame audit-frame--quiet flex items-center justify-between px-4 py-3"
    >
      <div>
        <p class="audit-eyebrow">
          {eyebrow}
        </p>
        <h1
          class="mt-2 text-3xl font-semibold tracking-tight text-[color:var(--audit-text-0)]"
        >
          {title}
        </h1>
      </div>

      <a href={backHref} class="audit-chip audit-chip--muted">
        {backLabel}
      </a>
    </header>

    <section
      class="audit-section grid gap-6 py-10 lg:grid-cols-[minmax(0,1fr)_18rem] lg:items-start"
    >
      <div class="space-y-6">
        <div class="audit-panel audit-panel--raised p-6 sm:p-7">
          <div class="flex flex-wrap items-center gap-2">
            <span class="audit-label"> Static support page </span>
            <span class="audit-chip audit-chip--muted"> Portfolio demo </span>
          </div>
          <p
            class="mt-4 max-w-2xl text-lg leading-8 text-[color:var(--audit-text-1)]"
          >
            {intro}
          </p>
          <p
            class="mt-4 max-w-2xl text-sm leading-6 text-[color:var(--audit-text-3)]"
          >
            {portfolioNote}
          </p>
        </div>

        <div class="grid gap-4">
          {
            sections.map((section) => (
              <article class="audit-card audit-card--quiet p-6 sm:p-7">
                <h2 class="text-xl font-semibold text-[color:var(--audit-text-0)]">
                  {section.title}
                </h2>
                <div class="mt-4 space-y-4 text-base leading-7 text-[color:var(--audit-text-1)]">
                  {section.paragraphs.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                </div>
                {section.bullets && (
                  <ul class="mt-5 grid gap-3">
                    {section.bullets.map((bullet) => (
                      <li class="audit-card audit-card--quiet px-4 py-3 text-base leading-7 text-[color:var(--audit-text-1)]">
                        {bullet}
                      </li>
                    ))}
                  </ul>
                )}
              </article>
            ))
          }
        </div>
      </div>

      <aside class="audit-panel audit-panel--raised space-y-4 p-6">
        <div>
          <p class="audit-label">
            {sidebarTitle}
          </p>
          <p class="mt-2 text-base leading-7 text-[color:var(--audit-text-1)]">
            {sidebarIntro}
          </p>
        </div>

        <div>
          <p class="audit-label">Scope notes</p>
          <ul class="mt-4 space-y-2">
            {
              sidebarPoints.map((point) => (
                <li class="audit-card audit-card--quiet px-4 py-3 text-base leading-7 text-[color:var(--audit-text-1)]">
                  {point}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="audit-panel audit-panel--inset p-4">
          <p class="audit-label">
            {contactTitle}
          </p>
          <ul
            class="mt-3 space-y-2 text-base leading-7 text-[color:var(--audit-text-1)]"
          >
            {
              contactLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="transition hover:text-[color:var(--audit-text-0)]"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </section>
  </main>
</BaseLayout>
